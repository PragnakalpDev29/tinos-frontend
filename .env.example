# WebSocket Configuration
# WebSocket host for real-time job status updates
# For local development: localhost:8000
# For production: your-django-backend-domain.com
NEXT_PUBLIC_WS_HOST=localhost:8000

# API Configuration
# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# AWS S3 Configuration
# AWS region for S3 bucket
AWS_REGION=us-east-1
# AWS access key ID
ACCESS_KEY=your-aws-access-key-id
# AWS secret access key
SECRET_KEY=your-aws-secret-access-key
# S3 bucket name (default: epicode-neoantigen)
BUCKET_NAME=epicode-neoantigen
# Default S3 path for RNA BAM file uploads
NEXT_PUBLIC_S3_RNA_BAM_UPLOAD_PATH=s3://epicode-neoantigen/pragnakalp_neoantigen_output/mansi
