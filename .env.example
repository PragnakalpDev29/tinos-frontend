# WebSocket Configuration
# WebSocket host for real-time job status updates
# For local development: localhost:8000
# For production: your-django-backend-domain.com
NEXT_PUBLIC_WS_HOST=localhost:8000

# API Configuration
# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_ID=your-google-client-id
GOOGLE_SECRET=your-google-client-secret

# Backend API URL (server-side — not exposed to browser)
BACKEND_API_URL=http://localhost:8000

# AWS S3 Configuration
# AWS region for S3 bucket
AWS_REGION=us-east-1
# AWS access key ID
ACCESS_KEY=your-aws-access-key-id
# AWS secret access key
SECRET_KEY=your-aws-secret-access-key
# S3 bucket name (default: epicode-neoantigen)
BUCKET_NAME=epicode-neoantigen
# Default S3 path for RNA BAM file uploads
NEXT_PUBLIC_S3_RNA_BAM_UPLOAD_PATH=s3://your-bucket/your-path

# Security — CORS and S3 defaults
# Restrict cross-origin access for upload endpoints
ALLOWED_ORIGIN=http://localhost:3000
# Default S3 paths for job forms (override in production)
NEXT_PUBLIC_DEFAULT_S3_BASE_PATH=
NEXT_PUBLIC_DEFAULT_S3_INPUT_PATH=
NEXT_PUBLIC_DEFAULT_S3_OUTPUT_PATH=
